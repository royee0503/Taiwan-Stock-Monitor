# ---------------------------------------------------------------------
# Personal data 
# ---------------------------------------------------------------------
# Watchlist, holdings (shares / cost), settings and cached quotes
watchlist.json

# Excel copies with the latest prices written back by the app,
# including the daily snapshots in stock/history/
stock/

# Personal holdings spreadsheets (imported into the app)
*.xlsx
*.xlsm
*.xls
*.csv
# Excel lock files created while a workbook is open
~$*
# To commit a sample/template workbook, un-comment and adjust:
# !台股監控清單範本.xlsx

# ---------------------------------------------------------------------
# Build output (PyInstaller)
# ---------------------------------------------------------------------
# Re-create anytime with:
#   python -m PyInstaller --onefile --windowed --name StockMonitor ^
#     --version-file version_info.txt --icon stock_monitor.ico Taiwan_Stock_Monitor.py
build/
dist/
*.spec
*.manifest
# Packaged executables copied outside dist/
*.exe

# Kept in the repo on purpose (do NOT ignore):
#   stock_monitor.ico   - app / exe icon
#   version_info.txt    - exe version details for PyInstaller

# ---------------------------------------------------------------------
# Python bytecode and caches
# ---------------------------------------------------------------------
__pycache__/
*.py[codz]
*$py.class

# ---------------------------------------------------------------------
# Virtual environments and local secrets
# ---------------------------------------------------------------------
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
.env
.envrc

# ---------------------------------------------------------------------
# Packaging metadata (pip / setuptools)
# ---------------------------------------------------------------------
*.egg-info/
*.egg
.eggs/
wheels/
pip-log.txt
pip-delete-this-directory.txt

# ---------------------------------------------------------------------
# Tests, linters and type checkers
# ---------------------------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.ruff_cache/
.mypy_cache/
.dmypy.json
dmypy.json

# ---------------------------------------------------------------------
# Editors and OS files
# ---------------------------------------------------------------------
# VS Code Code Runner temp file
tempCodeRunnerFile.py
# Un-comment to ignore all VS Code settings:
# .vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store

# ---------------------------------------------------------------------
